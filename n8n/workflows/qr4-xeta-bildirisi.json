{
  "id": "QrErrorNotify",
  "name": "QR4 - Xəta Bildirişi (Error Trigger)",
  "nodes": [
    {
      "parameters": {},
      "id": "qr000000-0000-4000-8000-000000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/notify",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
