        "jsonBody": "={{ JSON.stringify({ text: 'QiymətRadar xətası\\nWorkflow: ' + $json.workflow.name + '\\nNode: ' + $json.execution.lastNodeExecuted + '\\nXəta: ' + $json.execution.error.message }) }}"
      },
      "id": "qr000000-0000-4000-8000-000000000002",
      "name": "Bildiriş - Xəta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -160,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Bildiriş - Xəta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
