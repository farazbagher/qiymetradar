{
  "id": "QrPriceMonitor",
  "name": "QR1 - Qiymət Monitoru (scraping pipeline)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "qr000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1100,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "qr000000-0000-4000-8000-000000000002",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1100,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 3 səhifə (hər birində 8 məhsul). Real layihədə bu siyahı sayt konfiqurasiyasından gəlir.\nconst base = $env.DEMOSHOP_URL;\nreturn [1, 2, 3].map(p => ({ json: { page: p, url: `${base}/?page=${p}` } }));"
      },
      "id": "qr000000-0000-4000-8000-000000000003",
      "name": "Səhifə siyahısı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "QiymetRadarBot/1.0 (n8n)"
            }
          ]
        }
      },
      "id": "qr000000-0000-4000-8000-000000000004",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "article.product h3 a",
              "returnValue": "attribute",
              "attribute": "title",
              "returnArray": true
            },
            {
              "key": "price",
              "cssSelector": "article.product p.price",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "stock",
              "cssSelector": "article.product span.stock",
              "returnValue": "text",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "id": "qr000000-0000-4000-8000-000000000005",
      "name": "HTML",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// HTML node hər səhifə üçün 3 massiv qaytarır (Return Array). Hamısını bir siyahıya yığırıq.\n// Qiymətin ədədə çevrilməsi BURADA edilmir: xam mətni backend parse edir (tək həqiqət mənbəyi: £, ₼, '1 450,00' formatları).\nconst rows = [];\nfor (const item of $input.all()) {\n  const { title = [], price = [], stock = [] } = item.json;\n  for (let i = 0; i < title.length; i++) rows.push({ title: title[i], price: price[i], stock: stock[i] || '' });\n}\nreturn [{ json: { site: 'demoshop', strategy: 'n8n', rows } }];"
      },
      "id": "qr000000-0000-4000-8000-000000000006",
      "name": "Code - Birləşdir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/prices/ingest",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "qr000000-0000-4000-8000-000000000007",
      "name": "Backend - Qiymətləri yaz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/report/run?site=demoshop",
        "options": {
          "timeout": 120000
        }
      },
      "id": "qr000000-0000-4000-8000-000000000008",
      "name": "Backend - Hesabat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Backend - Qiymətləri yaz').first().json.stats.changes }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "qr000000-0000-4000-8000-000000000009",
      "name": "IF - dəyişiklik var?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        580,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/notify",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'QiymətRadar: ' + $json.text }) }}"
      },
      "id": "qr000000-0000-4000-8000-000000000010",
      "name": "Bildiriş - Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        -80
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Səhifə siyahısı",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Səhifə siyahısı",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Səhifə siyahısı": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTML": {
      "main": [
        [
          {
            "node": "Code - Birləşdir",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Birləşdir": {
      "main": [
        [
          {
            "node": "Backend - Qiymətləri yaz",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend - Qiymətləri yaz": {
      "main": [
        [
          {
            "node": "Backend - Hesabat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend - Hesabat": {
      "main": [
        [
          {
            "node": "IF - dəyişiklik var?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - dəyişiklik var?": {
      "main": [
        [
          {
            "node": "Bildiriş - Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "QrErrorNotify"
  }
}
